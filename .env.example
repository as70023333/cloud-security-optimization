# cloud-security-optimization settings. Copy to .env and fill in what you use. Real environment
# variables always win over this file. Never commit .env.
#
# 'secopt overlap' needs none of this: it only reads your inventory file.

# --- Sign-in (secopt sentinel, secopt licenses) -------------------------------------------------
# Pick one: secret | managed_identity | cli. Left empty: a client secret if one is set, else a
# managed identity if USE_MANAGED_IDENTITY=true, else your 'az login' session.
AZURE_AUTH=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
USE_MANAGED_IDENTITY=false

# --- secopt sentinel ----------------------------------------------------------------------------
# Full resource ID of the Log Analytics workspace Microsoft Sentinel runs on (same as --workspace):
# /subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<name>
SENTINEL_WORKSPACE_RESOURCE_ID=
# Currency for public list prices (same as --currency).
CURRENCY=USD

# --- Sovereign clouds only ----------------------------------------------------------------------
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.us
# AZURE_ARM_BASE_URL=https://management.usgovcloudapi.net
# LOG_ANALYTICS_BASE_URL=https://api.loganalytics.us
# GRAPH_BASE_URL=https://graph.microsoft.us

HTTP_TIMEOUT_SECONDS=60
